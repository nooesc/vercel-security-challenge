# Public URL of the observer as reached from Vercel Sandbox.
OBSERVER_BASE_URL=https://observer.example.test

# Shared only by the controller and observer admin API. Generate with:
#   openssl rand -hex 32
OBSERVER_ADMIN_KEY=replace-with-at-least-24-random-characters

# Observer process settings.
OBSERVER_HOST=127.0.0.1
OBSERVER_PORT=8787
OBSERVER_DATA_FILE=./observer-data/events.jsonl

# Harness settings.
HARNESS_ARTIFACTS_DIR=./artifacts
HARNESS_SANDBOX_TIMEOUT_MS=300000
HARNESS_COMMAND_TIMEOUT_MS=20000
OBSERVER_SETTLE_MS=1500

# Optional explicit SDK credentials. Prefer VERCEL_OIDC_TOKEN or the SDK's
# interactive local login; never commit real values.
# VERCEL_OIDC_TOKEN=
# VERCEL_TEAM_ID=
# VERCEL_PROJECT_ID=
# VERCEL_TOKEN=
